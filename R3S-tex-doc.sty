% ---------- 表格与列表 ----------
\RequirePackage{booktabs}       % 三线表
\RequirePackage{tabularx}       % 自适应列宽
\RequirePackage{enumitem}       % 列表定制
\setlist{nosep, left=0pt}   % 紧凑列表
\RequirePackage{multirow}      % 跨行合并
