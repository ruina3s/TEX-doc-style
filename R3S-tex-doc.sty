\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mysettings}[2026/08/01 v1.0 Custom Settings]

% ---------- 导言区字体配置 ----------
% 1. ctex 宏包（自动加载 fandol）
\RequirePackage[UTF8,fontset=fandol]{ctex}
\setCJKmainfont{SimSun}[
    BoldFont={SimSun},%          粗体仍使用宋体字形
    BoldFeatures={FakeBold=3},%  以 FakeBold 模拟加粗，实现“宋体粗体”
]
\setCJKsansfont{KaiTi}
\setCJKmonofont{FangSong}
% 2. 西文字体：Computer Modern Unicode
\RequirePackage{fontspec}
\setmainfont{cmun}[
    Extension = .otf,
    UprightFont = *rm,
    ItalicFont = *ti,
    SlantedFont = *sl,
    BoldFont = *bx,
    BoldItalicFont = *bi,
    BoldSlantedFont = *bl,
]
\setsansfont{cmun}[
    Extension = .otf,
    UprightFont = *ss,
    ItalicFont = *si,
    BoldFont = *sx,
    BoldItalicFont = *so,
]
\setmonofont{cmun}[
    Extension = .otf,
    UprightFont = *btl,
    ItalicFont = *bto,
    BoldFont = *tb,
    BoldItalicFont = *tx,
]
% 3. 数学字体（unicode-math 方案）
\RequirePackage{amsmath}
\RequirePackage{unicode-math}
\setmathfont{Latin Modern Math}
% --------------------------------

% ---------- 页面设置 ----------
\RequirePackage{geometry} % 页面设置
\geometry{left=2.8cm,right=2.8cm,top=2.5cm,bottom=2.5cm} % 页边距
