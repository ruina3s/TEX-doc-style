% ---------- 定理、定义环境 ----------
\RequirePackage{tcolorbox}
\tcbuselibrary{theorems,skins} % 引入定理和皮肤库

% 编号开关：在主文件导言区（\usepackage 之后、\begin{document} 之前）设置
% 随 section 自动编号：\thmwithsectiontrue
% 全局不编号：        \thmwithsectionfalse
\newif\ifthmwithsection
\thmwithsectiontrue % 默认保持原有行为

% 所有定理框共用的样式（#1=边框色，#2=背景色），外观与原来完全一致
\tcbset{
    mathbox/.style 2 args={
        enhanced,                    % 启用高级功能
        colframe=#1,                % 边框色
        colback=#2,                 % 背景色
        boxrule=0pt,                % 外边框宽度为0（只留左边框）
        leftrule=3pt,               % 左边框宽度（竖线效果）
        sharp corners,              % 直角
        fonttitle=\bfseries,        % 标题字体加粗
        coltitle=black,             % 标题颜色
        attach title to upper,      % 标题连接到内容上方（行内）
        separator sign={.},         % 标题与内容分隔符
        after title={\ },           % 标题后添加空格
        description delimiters parenthesis, % 描述文字用括号
        drop fuzzy shadow           % 模糊阴影
    }
}

% 统一的环境定义命令
% #1=环境名  #2=显示标题  #3=\label 前缀  #4=边框色  #5=背景色
% 是否随 section 编号由 \ifthmwithsection 统一控制
% [number within=section] 表示随 section 编号
% [no counter] 表示全局编号
\newcommand{\NewMathThm}[5]{%
    \ifthmwithsection
        \newtcbtheorem[number within=section]{#1}{#2}{mathbox={#4}{#5}}{#3}%
    \else
        \newtcbtheorem[no counter]{#1}{#2}{mathbox={#4}{#5}}{#3}%
    \fi
}
% 始终不编号的变体（原来的“练习”lx 就是 no counter，用它保持原样）
\newcommand{\NewMathThmUncounted}[5]{%
    \newtcbtheorem[no counter]{#1}{#2}{mathbox={#4}{#5}}{#3}%
}

\newif\ifcolormode
\colormodetrue % 默认彩色模式
% 延迟到 \begin{document} 才定义环境，
% 这样主文件可以在导言区改开关后再决定编号方式
\AtBeginDocument{%
    \ifcolormode
        \NewMathThm{dfn}{定义}{dfn}{math-bd-green}{math-bg-green}
        \NewMathThm{thm}{定理}{thm}{math-bd-blue}{math-bg-blue}
        \NewMathThm{exm}{例}{exm}{math-bd-violet}{math-bg-violet}
        \NewMathThm{warn}{错误}{warn}{math-bd-red}{math-bg-red}
        \NewMathThm{tip}{提示}{tip}{math-bd-orrange}{math-bg-orrange}
        % 原来的 lx 使用 [no counter]，保持不编号
        \NewMathThmUncounted{exs}{练习}{exer}{math-bd-aoi}{math-bg-aoi}
    \else        
        \NewMathThm{def}{定义}{def}{bw-bd}{bw-bg}
        \NewMathThm{thm}{定理}{thm}{bw-bd}{bw-bg}
        \NewMathThm{exm}{例}{exm}{bw-bd}{bw-bg}
        \NewMathThm{warn}{错误}{warn}{bw-bd}{bw-bg}
        \NewMathThm{tip}{提示}{tip}{bw-bd}{bw-bg}
        % 原来的 lx 使用 [no counter]，保持不编号
        \NewMathThmUncounted{exs}{练习}{exer}{bw-bd}{bw-bg}
    \fi
}
% ----------------------------------

% ---------- 练习与答案环境 ----------
\RequirePackage{comment}
% 答案显示控制
\newif\ifshowanswers
\newif\ifshowexplanations
\showanswerstrue
\showexplanationstrue
% 显示答案：\showanswerstrue
% 隐藏答案：\showanswersfalse
% 显示解析：\showexplanationstrue
% 隐藏解析：\showexplanationsfalse

% 延迟到文档开始时定义，这样主文件可以在 \usepackage 后改开关
\AtBeginDocument{%
    \ifshowanswers
        \newenvironment{answer}
            {\par\smallskip{\color{red}\bfseries 【答案】}} % 答案标题
            {\par\smallskip} % 答案结束
    \else
        \excludecomment{answer} 
    \fi
    \ifshowexplanations
        \newenvironment{explanation}
            {\par\smallskip{\color{red}\bfseries 【解析】解：}} % 解答标题
            {\par\smallskip} % 解答结束
    \else
        \excludecomment{explanation} 
    \fi
}
% 自定义练习环境
\newcounter{exercise}[section]
\renewcommand{\theexercise}{\thesection.\arabic{exercise}}
\newenvironment{exercise}
    {\par\vspace{0.3cm}\refstepcounter{exercise}
     \noindent\textbf{练习 \theexercise}\quad}
    {\par\vspace{0.2cm}}
% ----------------------------------

% ---------- 分栏 ----------
\RequirePackage{multicol} % 支持多栏
% -------------------------

% ---------- 目录分栏开关 ----------
\newif\ifmulticoltoc
\multicoltocfalse % 默认：目录不分栏
% 目录分两栏：\multicoltoctrue
% 目录不分栏：\multicoltocfalse
% 在调用时也可以选择是否分栏
\RequirePackage{etoolbox}

% 仿照答案/解析环境：延迟到文档开始时再决定
\AtBeginDocument{%
    \ifmulticoltoc
        \patchcmd{\tableofcontents}%
            {\@starttoc{toc}}%
            {\begin{multicols}{2}\@starttoc{toc}\end{multicols}}%
            {}%
            {\PackageWarning{R3S-tex-doc}{无法为目录启用分栏（patch 失败）}}%
    \fi
}
