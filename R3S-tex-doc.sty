% ---------- 练习与答案环境 ----------
\RequirePackage{comment}
% 答案显示控制
\newif\ifshowanswers
\newif\ifshowexplanations
\showanswerstrue
\showexplanationstrue
% 显示答案：\showanswerstrue
% 隐藏答案：\showanswersfalse
% 显示解析：\showexplanationstrue
% 隐藏解析：\showexplanationsfalse

% 延迟到文档开始时定义，这样主文件可以在 \usepackage 后改开关
\AtBeginDocument{%
    \ifshowanswers
        \newenvironment{answer}
            {\par\smallskip{\color{red}\bfseries 【答案】}} % 答案标题
            {\par\smallskip} % 答案结束
    \else
        \excludecomment{answer} 
    \fi
    \ifshowexplanations
        \newenvironment{explanation}
            {\par\smallskip{\color{red}\bfseries 【解析】解：}} % 解答标题
            {\par\smallskip} % 解答结束
    \else
        \excludecomment{explanation} 
    \fi
}
% 自定义练习环境
\newcounter{exercise}[section]
\renewcommand{\theexercise}{\thesection.\arabic{exercise}}
\newenvironment{exercise}
    {\par\vspace{0.3cm}\refstepcounter{exercise}
     \noindent\textbf{练习 \theexercise}\quad}
    {\par\vspace{0.2cm}}
